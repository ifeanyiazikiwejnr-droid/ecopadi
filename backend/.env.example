# Copy this file to .env for local dev, and set the same values as
# Environment Variables in your Render dashboard for production.

PORT=4000

# Render Postgres "External Database URL" (or your local Postgres connection string)
DATABASE_URL=postgresql://user:password@host:5432/ecopadi

# Long random string used to sign login tokens. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string

# Your live site URL, used for CORS + Stripe/PayPal redirect links
FRONTEND_URL=https://www.ecopadi.co.uk

# --- Payment gateways ---
# Get these from https://dashboard.stripe.com/apikeys (covers Visa/Mastercard + Apple Pay)
STRIPE_SECRET_KEY=sk_live_or_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Get these from https://developer.paypal.com (Live app credentials)
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENV=sandbox

# --- Bank transfer (manual) ---
# Deliberately NOT stored here for public exposure. Bank details for "pay by
# bank transfer" orders should be sent privately in the order confirmation
# email/invoice only, never rendered on any public page. Set them as an env
# var read only by the transactional email template, e.g.:
BANK_TRANSFER_ACCOUNT_NAME=ECOPADI UK LTD
BANK_TRANSFER_ACC_NO=REPLACE_ME
BANK_TRANSFER_SORT_CODE=REPLACE_ME
